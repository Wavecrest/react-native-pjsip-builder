# Pinned versions for every component of a release.
# After changing any version run `./fetch_sources.sh --pin` and commit checksums.sha256.

RELEASE_VERSION=5.0.0

PJSIP_VERSION=2.17
OPENSSL_VERSION=3.5.9
OPUS_VERSION=1.5.2

# Must match ndkVersion in mobile-app android/build.gradle (r27b = 27.1.12297006).
# Static C++ libs must be built with the same NDK the app links them with.
NDK_VERSION=r27b
# Must match minSdkVersion in mobile-app. Native libs built against a newer API
# can reference symbols that do not exist on older devices.
ANDROID_API=29
ANDROID_ABIS="arm64-v8a armeabi-v7a"

# Must not be higher than IPHONEOS_DEPLOYMENT_TARGET in mobile-app.
IOS_MIN_VERSION=15.1
